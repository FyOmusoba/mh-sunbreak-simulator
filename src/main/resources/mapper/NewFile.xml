<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mhsunbreaksimulator.mapper.PresetWeaponAugmentMapper">


    <!--
        =====================================================
        武器傀異錬成設定保存
        =====================================================
    -->
    <insert id="insert"
            parameterType="com.example.mhsunbreaksimulator.entity.PresetWeaponAugment">

        INSERT INTO preset_weapon_augment (
            preset_id,
            attack_level,
            element_level,
            affinity_level,
            sharpness_level
        )
        VALUES (
            #{presetId},
            #{attackLevel},
            #{elementLevel},
            #{affinityLevel},
            #{sharpnessLevel}
        )

    </insert>


    <!--
        =====================================================
        プリセットの武器傀異錬成設定取得
        =====================================================
    -->
    <select id="findByPresetId"
            resultType="com.example.mhsunbreaksimulator.entity.PresetWeaponAugment">

        SELECT
            preset_id,
            attack_level,
            element_level,
            affinity_level,
            sharpness_level
        FROM preset_weapon_augment
        WHERE preset_id = #{presetId}

    </select>


    <!--
        =====================================================
        プリセットの武器傀異錬成設定削除
        =====================================================
    -->
    <delete id="deleteByPresetId">

        DELETE FROM preset_weapon_augment
        WHERE preset_id = #{presetId}

    </delete>


</mapper>