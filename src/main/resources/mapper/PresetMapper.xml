<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mhsunbreaksimulator.mapper.PresetMapper">


    <!--
        =====================================================
        プリセット新規登録
        =====================================================

        preset_id は PostgreSQL の IDENTITY ALWAYS により
        DB側で自動採番される。

        採番された preset_id は
        Preset.presetId に格納される。
    -->
    <insert id="insert"
            parameterType="com.example.mhsunbreaksimulator.entity.Preset"
            useGeneratedKeys="true"
            keyProperty="presetId"
            keyColumn="preset_id">

        INSERT INTO preset (
            user_id,
            preset_name,
            weapon_id,
            rampage_decoration_id
        )
        VALUES (
            #{userId},
            #{presetName},
            #{weaponId},
            #{rampageDecorationId}
        )

    </insert>


    <!--
        =====================================================
        プリセット1件取得
        =====================================================

        preset_id と user_id の両方で検索することで、
        他ユーザーのプリセットを取得しないようにする。
    -->
    <select id="findByIdAndUserId"
            resultType="com.example.mhsunbreaksimulator.entity.Preset">

        SELECT
            preset_id,
            user_id,
            preset_name,
            weapon_id,
            rampage_decoration_id
        FROM preset
        WHERE preset_id = #{presetId}
          AND user_id = #{userId}

    </select>


    <!--
        =====================================================
        ユーザーのプリセット一覧取得
        =====================================================
    -->
    <select id="findByUserId"
            resultType="com.example.mhsunbreaksimulator.entity.Preset">

        SELECT
            preset_id,
            user_id,
            preset_name,
            weapon_id,
            rampage_decoration_id
        FROM preset
        WHERE user_id = #{userId}
        ORDER BY preset_id DESC

    </select>


    <!--
        =====================================================
        プリセット名変更
        =====================================================
    -->
    <update id="updateName">

        UPDATE preset
        SET preset_name = #{presetName}
        WHERE preset_id = #{presetId}
          AND user_id = #{userId}

    </update>


    <!--
        =====================================================
        プリセット本体削除
        =====================================================

        子テーブルは ON DELETE CASCADE ではないため、
        PresetDeleteService 側で先に削除してから
        このDELETEを実行する。
    -->
    <delete id="deleteByIdAndUserId">

        DELETE FROM preset
        WHERE preset_id = #{presetId}
          AND user_id = #{userId}

    </delete>


</mapper>