<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mhsunbreaksimulator.mapper.UserMapper">

    <select id="findByUsername"
            resultType="com.example.mhsunbreaksimulator.entity.User">

        SELECT
            user_id,
            username,
            password_hash
        FROM users
        WHERE username = #{username}

    </select>

    <insert id="insert"
            parameterType="com.example.mhsunbreaksimulator.entity.User"
            useGeneratedKeys="true"
            keyProperty="userId"
            keyColumn="user_id">

        INSERT INTO users (
            username,
            password_hash
        )
        VALUES (
            #{username},
            #{passwordHash}
        )

    </insert>

</mapper>