<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.mhsunbreaksimulator.mapper.BowgunAmmoMapper">

    <!-- ========================================== -->
    <!-- 指定した武器で使用できる弾一覧 -->
    <!-- ========================================== -->

    <select id="findByWeaponId"
            resultType="com.example.mhsunbreaksimulator.entity.BowgunAmmo">

        SELECT
            bowgun_ammo_id,
            weapon_id,
            ammo_type,
            ammo_level,
            capacity,
            rapid_fire,
            recoil,
            reload,
            moving_shot,
            moving_reload,
            single_auto
        FROM bowgun_ammo
        WHERE weapon_id = #{weaponId}
        ORDER BY
            ammo_type,
            ammo_level

    </select>


    <!-- ========================================== -->
    <!-- IDから1件取得 -->
    <!-- ========================================== -->

    <select id="findById"
            resultType="com.example.mhsunbreaksimulator.entity.BowgunAmmo">

        SELECT
            bowgun_ammo_id,
            weapon_id,
            ammo_type,
            ammo_level,
            capacity,
            rapid_fire,
            recoil,
            reload,
            moving_shot,
            moving_reload,
            single_auto
        FROM bowgun_ammo
        WHERE bowgun_ammo_id = #{bowgunAmmoId}

    </select>

</mapper>